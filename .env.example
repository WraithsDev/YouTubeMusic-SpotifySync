# https://developer.spotify.com/dashboard adresinden oluşturduğun uygulamanın bilgileri
SPOTIPY_CLIENT_ID=buraya_client_id
SPOTIPY_CLIENT_SECRET=buraya_client_secret
# Spotify panelinde Redirect URI olarak birebir aynısını ekle
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Spotify'da oluşturulacak çalma listesinin adı
PLAYLIST_NAME=YouTube Music Beğenilenler
